# Linktree Backend Environment Variables
# Copy this file to .env and fill in your values

# Application
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/linktree_db"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# File Uploads (local storage path inside container)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
