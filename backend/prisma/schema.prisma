// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  username     String   @unique
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  profile Profile?

  @@map("users")
}

model Profile {
  id            String   @id @default(cuid())
  userId        String   @unique @map("user_id")
  displayName   String   @map("display_name")
  bio           String?
  avatarUrl     String?  @map("avatar_url")
  templateSlug   String   @default("minimalist") @map("template_slug")
  isPublic       Boolean  @default(true) @map("is_public")
  umamiShareUrl  String?  @map("umami_share_url")
  umamiScriptUrl String?  @map("umami_script_url")
  umamiWebsiteId String?  @map("umami_website_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  links   Link[]
  socials SocialLink[]

  @@map("profiles")
}

model Link {
  id        String   @id @default(cuid())
  profileId String   @map("profile_id")
  title     String
  url       String
  icon      String?
  isActive  Boolean  @default(true) @map("is_active")
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("links")
}

model SocialLink {
  id        String   @id @default(cuid())
  profileId String   @map("profile_id")
  platform  String   // e.g., "twitter", "instagram", "github"
  url       String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("social_links")
}
