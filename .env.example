# ═══════════════════════════════════════════════════════════════
# Linktree App — Root Environment Variables
# Copy this file to .env and update the values for production
# ═══════════════════════════════════════════════════════════════

# ─── Application ───────────────────────────────────────────────
NODE_ENV=production

# ─── Database ──────────────────────────────────────────────────
POSTGRES_DB=linktree_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ─── JWT ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_SECRET_KEY
JWT_EXPIRES_IN=7d

# ─── CORS ──────────────────────────────────────────────────────
# The URL where your frontend is served (browser-facing)
CORS_ORIGIN=http://localhost:3000

# ─── Frontend API URL ──────────────────────────────────────────
# The URL the browser uses to reach the backend API
# In Docker with a reverse proxy, this would be your public domain
PUBLIC_API_URL=http://localhost:3001
